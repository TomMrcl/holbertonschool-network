#!/usr/bin/env bash
# Configures an Ubuntu server so that localhost resolves to 127.0.0.2 and facebook.com resolves to 8.8.8.8
cp /etc/hosts /etc/hosts.bak
sed 's/^127\.0\.0\.1\(\s.*localhost\)/127.0.0.2\1/' /etc/hosts.bak > /etc/hosts
if grep -q "facebook\.com" /etc/hosts; then
    sed -i 's/.*facebook\.com.*/8.8.8.8 facebook.com/' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
rm -f /etc/hosts.bak
